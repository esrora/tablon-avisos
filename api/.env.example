# Copia este fichero a .env y ajusta los valores.
# El .env NUNCA se sube al repositorio.

PORT=3000
ENTORNO=desarrollo

DB_HOST=localhost
DB_PORT=5432
DB_NAME=tablon
DB_USER=tablon
DB_PASSWORD=tablon

# Estos dos los rellenara el pipeline mas adelante.
APP_VERSION=0.0.0-dev
GIT_COMMIT=sin-commit

# Version minima que debe tener el cliente Java para poder funcionar.
MIN_CLIENT_VERSION=0.0.0
